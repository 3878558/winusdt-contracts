# Приватный ключ кошелька, с которого будет задеплоен контракт (creator).
# ⚠️ НИКОГДА не коммитьте реальный .env файл с приватным ключом в git!
# Скопируйте этот файл в .env и впишите свой ключ.
DEPLOYER_PRIVATE_KEY=

# Опционально: свои RPC-эндпоинты (если не указаны — используются публичные по умолчанию)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org
